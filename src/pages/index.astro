---
import DayTabs from "../components/DayTabs.astro";
import Legend from "../components/Legend.astro";
import LegendSheet from "../components/LegendSheet.astro";
import WeekGrid from "../components/WeekGrid.astro";
import Layout from "../layouts/Layout.astro";

/* After `Layout`, which pulls in `plan.css`: the print rules override the
 * screen ones at equal specificity, so they have to land last. */
import "../styles/print.css";

import { ACTIVE_YEAR, plans } from "../data";
import { buildPlan } from "../utils/plan";

const plan = buildPlan(plans[ACTIVE_YEAR]);
const { labels } = plan;
---

<Layout title={labels.pageTitle} locale={plan.locale}>
  <div class="plan" data-day="0">
    <div class="plan__main">
      <DayTabs days={plan.days} labels={labels} />
      <WeekGrid days={plan.days} rows={plan.rows} labels={labels} />
    </div>

    <aside class="legend-side">
      <h2 class="legend-side__title">{labels.legendTitle}</h2>
      <Legend groups={plan.legend} />
    </aside>

    <LegendSheet groups={plan.legend} labels={labels} />
  </div>
</Layout>

<script>
  /* The load sequence — the page owns the order, `src/scripts/` owns the work.
   *
   * Two runtime facts reach the page here, and neither may be baked into the
   * build: which weekday it is, and which day a phone is showing. Both are
   * applied before motion is armed on the last lines, and that order is the
   * whole reason this stays a sequence rather than three independent modules
   * wiring themselves up.
   */
  import { findTodayIndex, markToday } from "../scripts/today";
  import { initDaySelect } from "../scripts/day-select";
  import { initLegendSheet } from "../scripts/legend-sheet";

  const todayIndex = findTodayIndex();
  markToday(todayIndex);
  /* No column for today means the weekend: open on Monday. */
  initDaySelect(todayIndex < 0 ? 0 : todayIndex);
  initLegendSheet();

  /* Only now is motion allowed. The day set above is the clock being applied,
   * not a day being picked, and it would otherwise slide in from Monday on
   * every load. Reading the layout settles that day while the CSS still says
   * `transition: none`, so enabling motion on the next line has nothing left
   * to animate — and unlike waiting a frame, it does not depend on the tab
   * being on screen to happen at all. */
  const plan = document.querySelector<HTMLElement>(".plan");
  plan?.getBoundingClientRect();
  plan?.classList.add("plan--ready");
</script>

---
import DayTabs from "../components/v2/DayTabs.astro";
import Legend from "../components/v2/Legend.astro";
import WeekGrid from "../components/v2/WeekGrid.astro";
import V2Layout from "../layouts/V2Layout.astro";

import lessonsData from "../data/lessons.json";
import type { LessonsPlan } from "../data/lessonTypes";
import { buildPlan } from "../utils/v2/plan.ts";

/* The JSON leaves empty slots as `{}`, which the Lesson type does not model;
 * buildPlan treats a lesson without an id as an empty slot. */
const plan = buildPlan(lessonsData as unknown as LessonsPlan);
---

<V2Layout title="Plan lekcji">
  <div class="plan" data-day={plan.initialDayIndex}>
    <div class="plan__main">
      <DayTabs days={plan.days} initialDayIndex={plan.initialDayIndex} />
      <WeekGrid days={plan.days} rows={plan.rows} />
    </div>

    <aside class="legend-side">
      <h2 class="legend-side__title">Legenda kolorów</h2>
      <Legend groups={plan.legend} />
    </aside>

    <button class="fab" type="button" id="legendButton" aria-expanded="false">
      <span aria-hidden="true">?</span>
      <span class="sr-only">Legenda kolorów</span>
    </button>

    <div class="sheet" id="legendSheet" hidden>
      <div class="sheet__panel" role="dialog" aria-label="Legenda kolorów">
        <div class="sheet__head">
          <span class="sheet__title">Legenda kolorów</span>
          <span class="sheet__hint">dotknij, aby zamknąć</span>
        </div>
        <Legend groups={plan.legend} />
      </div>
    </div>
  </div>
</V2Layout>

<script>
  /* The page is built once a term, so "today" cannot be baked in: it is
   * recomputed on load and the DZIŚ marks are moved to match. Everything else
   * here is the one interaction the design allows — picking a day, which only
   * exists on a phone in portrait. */
  const plan = document.querySelector<HTMLElement>(".plan");
  const tabs = Array.from(document.querySelectorAll<HTMLElement>(".tab"));
  const dayHeads = Array.from(document.querySelectorAll<HTMLElement>(".dayhead"));
  const grid = document.querySelector<HTMLElement>(".grid");
  const legendButton = document.getElementById("legendButton");
  const legendSheet = document.getElementById("legendSheet");

  const LAST_DAY = 4;
  const SWIPE_MIN = 36;

  const weekday = new Date().getDay();
  /* Saturday and Sunday have no column: the plan opens on Monday. */
  const todayIndex = weekday >= 1 && weekday <= 5 ? weekday - 1 : -1;

  function markToday() {
    tabs.forEach((tab, index) =>
      tab.classList.toggle("tab--today", index === todayIndex),
    );
    dayHeads.forEach((head, index) =>
      head.classList.toggle("dayhead--today", index === todayIndex),
    );
  }

  function selectDay(index: number) {
    if (!plan || index < 0 || index > LAST_DAY) return;
    plan.dataset.day = String(index);
    tabs.forEach((tab, i) =>
      tab.setAttribute("aria-selected", String(i === index)),
    );
  }

  function currentDay(): number {
    return Number(plan?.dataset.day ?? 0);
  }

  function setLegendOpen(open: boolean) {
    if (!legendSheet || !legendButton) return;
    legendSheet.hidden = !open;
    legendButton.setAttribute("aria-expanded", String(open));
  }

  markToday();
  selectDay(todayIndex < 0 ? 0 : todayIndex);

  tabs.forEach((tab, index) =>
    tab.addEventListener("click", () => selectDay(index)),
  );

  legendButton?.addEventListener("click", () =>
    setLegendOpen(legendSheet?.hidden ?? true),
  );
  legendSheet?.addEventListener("click", () => setLegendOpen(false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setLegendOpen(false);
  });

  /* Swipe changes the day by one and does not wrap from Friday to Monday. */
  let swipeStartX: number | null = null;
  grid?.addEventListener("pointerdown", (event) => {
    swipeStartX = event.clientX;
  });
  grid?.addEventListener("pointerup", (event) => {
    if (swipeStartX === null) return;
    const dx = event.clientX - swipeStartX;
    swipeStartX = null;
    if (Math.abs(dx) < SWIPE_MIN) return;
    selectDay(currentDay() + (dx < 0 ? 1 : -1));
  });
</script>

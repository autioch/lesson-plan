---
import Layout from "../layouts/Layout.astro";
import DayTabs from "../components/v2/DayTabs.astro";
import WeekGrid from "../components/v2/WeekGrid.astro";
import LegendModal from "../components/v2/LegendModal.astro";
import LegendSidebar from "../components/v2/LegendSidebar.astro";

// Import data
import allData from "../data/lessons.json";

// Import styles
import "../assets/v2/tokens.css";
import "../assets/v2/v2.css";

// Type definitions
interface TimeSlot {
  start: string;
  duration: number;
}

interface Lesson {
  lessonId: string;
  teacherId: string;
  paused?: boolean;
  ignored?: boolean;
}

interface Day {
  name: string;
  short: string;
  lessons: Record<number, Lesson>;
}

interface LessonType {
  id: string;
  name: string;
  color: string;
}

// Extract data from allData
const {
  slots,
  lessonTypes: lessonTypesList,
  teachers: teachersList,
  days: daysList,
} = allData as any;

// Build lessonTypes map
const lessonTypes: Record<string, LessonType> = {};
lessonTypesList.forEach((type: any) => {
  lessonTypes[type.id] = {
    id: type.id,
    name: type.name,
    color: type.color,
  };
});

// Build teachers map
const teachers: Record<string, string> = {};
teachersList.forEach((teacher: any) => {
  teachers[teacher.id] = teacher.name;
});

// Transform days with short names
const days: Day[] = daysList.map((day: any) => ({
  name: day.name,
  short: day.name.slice(0, 2).toUpperCase(),
  lessons: day.lessons || {},
}));

// Calculate today's index
const today = new Date();
const dayOfWeek = today.getDay();
const todayIndex = dayOfWeek > 0 && dayOfWeek < 6 ? dayOfWeek - 1 : 0;
---

<Layout title="Plan lekcji - v2">
  <div class="v2-container">
    <div class="v2-content">
      <!-- Day tabs (portrait only) -->
      <DayTabs
        days={days}
        selectedDayIndex={todayIndex}
        todayIndex={todayIndex}
      />

      <!-- Main week grid -->
      <WeekGrid
        days={days}
        slots={slots}
        selectedDayIndex={todayIndex}
        todayIndex={todayIndex}
        lessonTypes={lessonTypes}
        teachers={teachers}
        layout="portrait"
      />

      <!-- Legend button (mobile only) -->
      <button
        class="v2-legend-btn"
        id="legendToggleBtn"
        aria-label="Pokaż legendę"
      >
        ?
      </button>
    </div>

    <!-- Legend modal (mobile only) -->
    <LegendModal lessonTypes={Object.values(lessonTypes)} isOpen={false} />

    <!-- Legend sidebar (desktop only) -->
    <LegendSidebar lessonTypes={Object.values(lessonTypes)} />
  </div>

  <script>
    // State management
    let selectedDayIndex = 0;
    let isLegendOpen = false;

    // DOM elements
    const legendBtn = document.getElementById(
      "legendToggleBtn",
    ) as HTMLButtonElement | null;
    const legendModal = document.querySelector(
      ".v2-legend-modal",
    ) as HTMLElement | null;
    const dayTabs = document.querySelectorAll(
      ".v2-tab",
    ) as NodeListOf<HTMLElement>;
    const weekGrid = document.querySelector(
      ".v2-week-grid",
    ) as HTMLElement | null;

    /**
     * Update the selected day and re-render visible grid
     */
    function selectDay(dayIndex: number) {
      selectedDayIndex = dayIndex;

      // Update tab states
      dayTabs.forEach((tab, idx) => {
        if (idx === dayIndex) {
          tab.classList.add("v2-tab--active");
          tab.setAttribute("aria-pressed", "true");
        } else {
          tab.classList.remove("v2-tab--active");
          tab.setAttribute("aria-pressed", "false");
        }
      });

      // Update grid view (hide/show rows based on selected day)
      // For portrait: only show cells for selected day
      updateGridDisplay();
    }

    /**
     * Update grid display based on current layout and selected day
     */
    function updateGridDisplay() {
      // Re-render grid cells (this is handled by CSS in portrait mode)
      // The TimeSlotRow components already use data-day-index
      const rows = document.querySelectorAll(
        ".v2-time-row",
      ) as NodeListOf<HTMLElement>;
      rows.forEach((row) => {
        // Update cell visibility based on selected day
        // This is handled by the TimeSlotRow component via CSS grid
      });
    }

    /**
     * Toggle legend modal (mobile only)
     */
    function toggleLegend() {
      isLegendOpen = !isLegendOpen;
      if (legendModal) {
        legendModal.setAttribute("data-legend-open", String(isLegendOpen));
        legendModal.setAttribute("aria-hidden", String(!isLegendOpen));
      }
    }

    /**
     * Close legend modal on backdrop click
     */
    function closeLegend() {
      isLegendOpen = false;
      if (legendModal) {
        legendModal.setAttribute("data-legend-open", "false");
        legendModal.setAttribute("aria-hidden", "true");
      }
    }

    /**
     * Detect swipe gesture for day navigation (portrait only)
     */
    let touchStartX = 0;
    let touchEndX = 0;

    function handleSwipe() {
      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;

      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0 && selectedDayIndex < 4) {
          // Swipe left: next day
          selectDay(selectedDayIndex + 1);
        } else if (diff < 0 && selectedDayIndex > 0) {
          // Swipe right: previous day
          selectDay(selectedDayIndex - 1);
        }
      }
    }

    // Event listeners
    if (legendBtn) {
      legendBtn.addEventListener("click", toggleLegend);
    }

    if (legendModal) {
      legendModal.addEventListener("click", closeLegend);
      // Prevent modal from closing when clicking inside the panel
      const panel = legendModal.querySelector(
        ".v2-legend-modal__panel",
      ) as HTMLElement | null;
      if (panel) {
        panel.addEventListener("click", (e) => e.stopPropagation());
      }
    }

    dayTabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => {
        selectDay(idx);
      });
    });

    // Swipe detection on grid
    if (weekGrid) {
      weekGrid.addEventListener("touchstart", (e) => {
        touchStartX = e.changedTouches[0].screenX;
      });

      weekGrid.addEventListener("touchend", (e) => {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
      });
    }

    // Set initial state
    selectDay(0);

    // Monitor viewport changes for responsive layout updates
    const mediaQueryPortrait = window.matchMedia("(orientation: portrait)");
    const mediaQueryDesktop = window.matchMedia("(min-width: 1024px)");

    function handleMediaChange() {
      // Re-calculate visible days and update grid
      updateGridDisplay();
    }

    if (mediaQueryPortrait.addEventListener) {
      mediaQueryPortrait.addEventListener("change", handleMediaChange);
    }
    if (mediaQueryDesktop.addEventListener) {
      mediaQueryDesktop.addEventListener("change", handleMediaChange);
    }
  </script>
</Layout>

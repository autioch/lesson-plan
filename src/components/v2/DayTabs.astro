---
/**
 * Day selection — phone portrait only (≤480px). Hidden by CSS everywhere else,
 * because every wider band shows the whole week and has nothing to switch.
 *
 * Today always reads DZIŚ and takes a wider tab, even when another day is
 * viewed. The viewed day takes the full name and a 3px bar; the rest take the
 * two-letter short.
 */
import type { PlanDay } from "../../utils/v2/plan.ts";

interface Props {
  days: PlanDay[];
  initialDayIndex: number;
}

const { days, initialDayIndex } = Astro.props;
---

<div class="tabs" role="tablist" aria-label="Dzień tygodnia">
  {
    days.map((day, index) => (
      <button
        class:list={["tab", { "tab--today": day.isToday }]}
        type="button"
        role="tab"
        data-day-index={index}
        aria-selected={index === initialDayIndex ? "true" : "false"}
        aria-label={`${day.name}${day.isToday ? " (dziś)" : ""}`}
      >
        <span class="tab__today">DZIŚ</span>
        <span class="tab__full">{day.name}</span>
        <span class="tab__short">{day.short}</span>
      </button>
    ))
  }
</div>

---
interface LessonType {
  id: string;
  name: string;
  color: string;
}

interface Props {
  lessonTypes: LessonType[];
}

const { lessonTypes } = Astro.props;
---

<aside class="v2-legend-sidebar">
  <div class="v2-legend-sidebar__content">
    <h2 class="v2-legend-sidebar__title">Legenda kolorów</h2>

    <div class="v2-legend-sidebar__list">
      {
        lessonTypes.map((type) => (
          <div class="v2-legend-item">
            <span
              class="v2-legend-item__color"
              style={`background-color: ${type.color}`}
            />
            <div class="v2-legend-item__content">
              <span class="v2-legend-item__name">{type.name}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</aside>

<style>
  .v2-legend-sidebar {
    background-color: var(--surface-raised);
    border-left: var(--border-width-thin) solid var(--line-subtle);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    height: 100%;
  }

  .v2-legend-sidebar__content {
    padding: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .v2-legend-sidebar__title {
    margin: 0;
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    color: var(--text-primary);
    line-height: var(--lh-body-min);
  }

  .v2-legend-sidebar__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .v2-legend-item {
    display: flex;
    gap: var(--space-12);
    align-items: flex-start;
  }

  .v2-legend-item__color {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    border: var(--border-width-thin) solid var(--line-subtle);
  }

  .v2-legend-item__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .v2-legend-item__name {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    line-height: var(--lh-body-min);
    color: var(--text-primary);
  }

  /* Show only on desktop */
  @media (max-width: 1023px) {
    .v2-legend-sidebar {
      display: none;
    }
  }
</style>

---
import { getTextColorCSS } from "../../utils/v2/color";

interface Props {
  lessonName?: string;
  teacherName?: string;
  backgroundColor?: string;
  isPaused?: boolean;
  breakText?: string;
}

const {
  lessonName = "",
  teacherName = "",
  backgroundColor = "#e8e8e8",
  isPaused = false,
  breakText = "",
} = Astro.props;

const textColor = getTextColorCSS(backgroundColor);
const classes = `v2-cell ${isPaused ? "v2-cell--paused" : ""}`;
---

<div
  class={classes}
  style={`background-color: ${backgroundColor}; color: ${textColor};`}
>
  <div class="v2-cell__content">
    {lessonName && <span class="v2-cell__name">{lessonName}</span>}
    {teacherName && <span class="v2-cell__teacher">{teacherName}</span>}
    {breakText && <span class="v2-cell__break">{breakText}</span>}
  </div>
</div>

<style>
  .v2-cell {
    padding: var(--space-12);
    border: var(--border-width-thin) solid var(--line-subtle);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
    min-height: 3rem; /* Touch target */
    border-radius: var(--radius-sm);
  }

  .v2-cell__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .v2-cell__name {
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    line-height: var(--lh-body-min);
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .v2-cell__teacher {
    font-size: var(--fs-xs);
    line-height: var(--lh-body-min);
    opacity: 0.85;
  }

  .v2-cell__break {
    font-size: var(--fs-xs);
    line-height: var(--lh-body-min);
    opacity: 0.7;
  }

  .v2-cell--paused .v2-cell__name {
    text-decoration: line-through;
    opacity: 0.6;
  }

  .v2-cell--paused .v2-cell__teacher {
    opacity: 0.5;
  }
</style>

---
/**
 * The day-name band above the grid — a header, not a first row of content.
 *
 * It bleeds to the edges of the area it heads and carries the rows' own gap and
 * side inset, so each name sits over its column. The leading corner is the
 * empty square above the time gutter; it exists to keep the band aligned with
 * the rows below it.
 *
 * No day is marked today here. The site is built once a term, so the page
 * script adds `dayhead--today` after it has read the clock — the band ships
 * unmarked and stays that way on paper.
 *
 * Exposes the `js-day-head` hook, counted in week order: the script marks the
 * one at today's index, so the days must stay in the order the data gives them.
 */
import type { Day, Labels } from "../data/types";

type Props = {
  days: Day[];
  labels: Labels;
};

const { days, labels } = Astro.props;
---

<div class="grid__head">
  <span class="grid__corner"></span>
  {
    days.map((day) => (
      <span class="dayhead js-day-head" title={day.name}>
        <span class="dayhead__name">{day.name}</span>
        <span class="dayhead__today">{labels.today}</span>
      </span>
    ))
  }
</div>

---
/**
 * The day-name band above the grid — a header, not a first row of content. It
 * carries the rows' own gap and side inset so each name sits over its column;
 * the leading corner is the empty square above the time gutter that keeps the
 * band aligned with the rows.
 *
 * No day is marked today here — the page script adds `dayhead--today` after
 * reading the clock, so the band ships unmarked and stays that way on paper.
 *
 * Exposes `js-day-head`, counted in week order: the script marks the one at
 * today's index, so the days must stay in the data's order.
 */
import type { Day, Labels } from "../data/types";

type Props = {
  days: Day[];
  labels: Labels;
};

const { days, labels } = Astro.props;
---

<div class="grid__head">
  <span class="grid__corner"></span>
  {
    days.map((day) => (
      <span class="dayhead js-day-head" title={day.name}>
        <span class="dayhead__name">{day.name}</span>
        <span class="dayhead__today">{labels.today}</span>
      </span>
    ))
  }
</div>

---
/**
 * Day selection — phone portrait only (≤480px), hidden by CSS everywhere else.
 * The build marks no day: the page script adds `tab--today` and the aria suffix
 * once it has read the clock, so until then (and with JavaScript off) Monday is
 * selected.
 *
 * Exposes `js-day-tabs` and `js-day-tab`. `tab--today` goes the other way — the
 * script writes it and CSS reads it, so it stays a BEM modifier.
 */
import type { Day, Labels } from "../data/types";

type Props = {
  days: Day[];
  labels: Labels;
}

const { days, labels } = Astro.props;
---

<div
  class="tabs js-day-tabs"
  role="tablist"
  aria-label={labels.dayTabsLabel}
  data-today-aria={labels.todayAria}
>
  {
    days.map((day, index) => (
      <button
        class="tab js-day-tab"
        type="button"
        role="tab"
        data-weekday={day.weekday}
        aria-selected={index === 0 ? "true" : "false"}
        aria-label={day.name}
      >
        <span class="tab__today">{labels.today}</span>
        <span class="tab__full">{day.name}</span>
        <span class="tab__short">{day.nameShort}</span>
      </button>
    ))
  }
</div>

---
/**
 * Day selection — phone portrait only (≤480px). Hidden by CSS everywhere else,
 * because every wider band shows the whole week and has nothing to switch.
 *
 * The build marks no day: today is a runtime fact, so the page script adds
 * `tab--today` and the aria suffix once it has read the clock. Until then Monday
 * is selected, which is also what a page without JavaScript shows.
 *
 * Exposes the `js-day-tabs` and `js-day-tab` hooks. `tab--today` goes the other
 * way — the script writes it and CSS reads it, so it stays a BEM modifier.
 *
 * Today always reads the today label and takes a wider tab, even when another
 * day is viewed. The viewed day takes the full name and a 3px bar; the rest take
 * the two-letter short.
 */
import type { Day, Labels } from "../data/types";

type Props = {
  days: Day[];
  labels: Labels;
}

const { days, labels } = Astro.props;
---

<div
  class="tabs js-day-tabs"
  role="tablist"
  aria-label={labels.dayTabsLabel}
  data-today-aria={labels.todayAria}
>
  {
    days.map((day, index) => (
      <button
        class="tab js-day-tab"
        type="button"
        role="tab"
        data-weekday={day.weekday}
        aria-selected={index === 0 ? "true" : "false"}
        aria-label={day.name}
      >
        <span class="tab__today">{labels.today}</span>
        <span class="tab__full">{day.name}</span>
        <span class="tab__short">{day.nameShort}</span>
      </button>
    ))
  }
</div>

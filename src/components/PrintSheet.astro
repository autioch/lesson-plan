---
/**
 * The printed plan — a separate view, not a scaled screen. One A4 landscape
 * page: the week grid with full names, the hours in the left gutter, and the
 * legend across the bottom. No "today": the sheet hangs on the fridge all term.
 *
 * Hidden on screen; the screen view is hidden in print.
 */
import type { Labels } from "../data/types";
import type { LegendGroup, PlanDay, PlanRow } from "../utils/plan";

interface Props {
  days: PlanDay[];
  rows: PlanRow[];
  legend: LegendGroup[];
  labels: Labels;
}

const { days, rows, legend, labels } = Astro.props;
---

<section class="print-sheet" aria-hidden="true">
  <div class="print-head">
    <span class="print-corner"></span>
    {days.map((day) => <span class="print-dayhead">{day.name}</span>)}
  </div>

  <div class="print-rows">
    {
      rows.map((row) => (
        <div class="print-row">
          <div class="print-time">
            <span class="print-range">{row.range}</span>
            {row.breakText && (
              <span class="print-break">{row.breakText}</span>
            )}
          </div>
          {row.cells.map((cell) =>
            cell.empty ? (
              <div class="print-cell print-cell--empty">
                <span class="print-free">{labels.freeSlot}</span>
              </div>
            ) : (
              <div class="print-cell" style={`--cell-bg:${cell.color}`}>
                <span class="print-lesson">{cell.name}</span>
                {cell.teacher && (
                  <span class="print-teacher">{cell.teacher}</span>
                )}
              </div>
            ),
          )}
        </div>
      ))
    }
  </div>

  <ul class="print-legend">
    {
      legend.map((group) => (
        <li class="print-legend__item">
          <span class="print-legend__swatch" style={`background:${group.color}`} />
          <span class="print-legend__title">{group.title}</span>
        </li>
      ))
    }
  </ul>
</section>

---
/**
 * The legend where there is no room for a column: the "?" button and the sheet
 * it opens, bands A and B only. From 1024px it is a fixed sidebar and this pair
 * is hidden — same `Legend` list either way, never a second copy.
 *
 * Open state lives in one place, the sheet's `hidden` attribute; the page
 * script sets it and knows nothing about animation (CSS drives the slide off
 * it). Exposes `js-legend-button` and `js-legend-sheet`.
 *
 * Neither element carries an id, so there is no `aria-controls` back to the
 * button — an open a11y gap, tracked separately.
 */
import type { Labels, PaletteColor } from "../data/types";
import Legend from "./Legend.astro";

type Props = {
  groups: PaletteColor[];
  labels: Labels;
};

const { groups, labels } = Astro.props;
---

<button class="fab js-legend-button" type="button" aria-expanded="false">
  <span aria-hidden="true">?</span>
  <span class="sr-only">{labels.legendTitle}</span>
</button>

<div class="sheet js-legend-sheet" hidden>
  <div class="sheet__panel" role="dialog" aria-label={labels.legendTitle}>
    <div class="sheet__head">
      <span class="sheet__title">{labels.legendTitle}</span>
      <span class="sheet__hint">{labels.legendHint}</span>
    </div>
    <Legend groups={groups} />
  </div>
</div>

---
/**
 * The plan itself. One DOM for all three bands: every day is always rendered,
 * and which of them you see is a CSS decision, never a build-time one.
 *
 * - ≤480px: the row is the time gutter plus the selected day's cell; the four
 *   other cells are hidden by the `data-day` attribute on the page root.
 * - 481–1023px: gutter plus five columns, shortened names, no teacher.
 * - ≥1024px: the same five columns with full names and teachers.
 *
 * No day header is marked today at build time — the page script does it.
 */
import type { Labels } from "../data/types";
import type { PlanDay, PlanRow } from "../utils/plan";

type Props = {
  days: PlanDay[];
  rows: PlanRow[];
  labels: Labels;
}

const { days, rows, labels } = Astro.props;
---

<div class="grid">
  <div class="grid__head">
    <span class="grid__corner"></span>
    {
      days.map((day) => (
        <span class="dayhead" data-weekday={day.weekday} title={day.name}>
          <span class="dayhead__name">{day.name}</span>
          <span class="dayhead__today">{labels.today}</span>
        </span>
      ))
    }
  </div>

  <div class="rows">
    {
      rows.map((row) => (
        <div class="row">
          <div class="row__time">
            <span class="row__range">{row.range}</span>
            {row.breakText && <span class="row__break">{row.breakText}</span>}
          </div>

          {row.cells.map((cell, dayIndex) =>
            cell.empty ? (
              <div class="cell cell--empty" data-day-index={dayIndex}>
                <span class="cell__free">{labels.freeSlot}</span>
              </div>
            ) : (
              <div
                class="cell"
                data-day-index={dayIndex}
                style={`--cell-bg:${cell.color}`}
              >
                <span class="cell__name">{cell.name}</span>
                <span class="cell__short">{cell.short}</span>
                {cell.teacher && (
                  <span class="cell__teacher">{cell.teacher}</span>
                )}
              </div>
            ),
          )}
        </div>
      ))
    }
  </div>
</div>

---
/**
 * One hour of the week: the time gutter, then one cell per day. The gutter is
 * the row's anchor — in band A the only thing that stays put while the days
 * slide behind it, which is why it is opaque and above them in the stack.
 *
 * `breakText` is empty when the next hour follows directly, so the span is
 * omitted; `src/utils/plan.ts` decides that, not this component.
 */
import type { Labels } from "../data/types";
import type { PlanRow } from "../utils/plan";
import LessonCell from "./LessonCell.astro";

type Props = {
  row: PlanRow;
  labels: Labels;
};

const { row, labels } = Astro.props;
---

<div class="row">
  <div class="row__time">
    <span class="row__range">{row.range}</span>
    {row.breakText && <span class="row__break">{row.breakText}</span>}
  </div>

  {
    row.cells.map((cell, dayIndex) => (
      <LessonCell cell={cell} dayIndex={dayIndex} labels={labels} />
    ))
  }
</div>
